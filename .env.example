# ============================================================
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA comite o .env real. Ele está no .gitignore.
# ============================================================

# --- Ngrok (pegue em https://dashboard.ngrok.com) ---
NGROK_AUTHTOKEN=
BRN_USE_NGROK=1

# --- Rede ---
BRN_NETWORK_ID=brn-mainnet-1
BRN_P2P_HOST=0.0.0.0
BRN_P2P_PORT=7777
BRN_SEED_PEERS=

# --- Web / dashboard ---
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000

# --- Persistência ---
BRN_DB_PATH=blockchain.db
BRN_IDENTITY_FILE=node_identity.json
BRN_FAUCET_KEY_FILE=faucet_identity.json

# --- Consenso ---
BRN_BLOCK_REWARD=50
BRN_MIN_STAKE=100

# --- Faucet ---
BRN_FAUCET_ADDRESS=
BRN_FAUCET_AMOUNT=100
BRN_FAUCET_COOLDOWN=3600

# --- Alocações iniciais de gênese ---
# Formato: endereco1:1000000,endereco2:500000
BRN_GENESIS_ALLOC=